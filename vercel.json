{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run check",
  "installCommand": "",
  "outputDirectory": "public",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/poster-world",
      "destination": "/poster-world.html"
    },
    {
      "source": "/listening-gallery",
      "destination": "/stillroom/experience.html"
    },
    {
      "source": "/work/bybit",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/visual-works",
      "destination": "/index.html"
    },
    {
      "source": "/preview",
      "destination": "/index.html"
    },
    {
      "source": "/the-handmaiden",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
